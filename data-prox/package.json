{
  "name": "record-matcher-perf-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript performance exercise: match primary records to reference records.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import=tsx --test --test-reporter=spec test/match-records.test.ts",
    "test:watch": "node --import=tsx --test --test-reporter=spec --watch test/match-records.test.ts",
    "bench": "tsx bench/run-benchmark.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
